{
  "name": "techradar",
  "version": "1.0.0",
  "description": "AI-powered personal technology discovery engine for developers - FSD, DevOps, AI/ML",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js schedule",
    "dev": "tsx src/index.ts schedule",
    "collect": "tsx src/index.ts collect",
    "digest:daily": "tsx src/index.ts digest:daily",
    "digest:weekly": "tsx src/index.ts digest:weekly",
    "digest:latest": "tsx src/index.ts digest:latest",
    "search": "tsx src/index.ts search",
    "show": "tsx src/index.ts show",
    "starred": "tsx src/index.ts starred",
    "stats": "tsx src/index.ts stats",
    "help": "tsx src/index.ts help",
    "web": "tsx src/web/server.ts"
  },
  "keywords": [
    "technology",
    "discovery",
    "ai",
    "devops",
    "fullstack",
    "ml"
  ],
  "author": "Krati Joshi",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@libsql/client": "^0.18.0",
    "@types/express": "^5.0.6",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^5.2.1",
    "marked": "^11.1.0",
    "node-cron": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.0",
    "@vercel/node": "^15.0.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
