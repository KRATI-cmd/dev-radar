# Optional: enables Claude-powered analysis (falls back to free rule-based analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required on Vercel (optional locally, where a local SQLite file is used)
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Required on Vercel: protects /api/cron/daily from being triggered by anyone
CRON_SECRET=any_long_random_string
